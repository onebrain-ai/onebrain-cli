<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Description>onebrain scheduler corpus</Description></RegistrationInfo>
  <Triggers>
    <!-- cron `0 17 * 3 5` — Fridays in March. UNREPRESENTABLE as one trigger:
         ScheduleByWeek has no <Months> element. Measured 2026-07-27:
         "ERROR: The task XML contains an unexpected node. (11,11):Months:"
         Pinned so the renderer keeps rejecting month+weekday instead of
         silently emitting a document that drops one of the two. -->
    <CalendarTrigger>
      <StartBoundary>2000-01-01T17:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <WeeksInterval>1</WeeksInterval>
        <DaysOfWeek><Friday /></DaysOfWeek>
        <Months><March /></Months>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>__USER__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <Enabled>true</Enabled>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <StartWhenAvailable>true</StartWhenAvailable>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>

  </Settings>
  <Actions Context="Author">
    <Exec><Command>cmd.exe</Command><Arguments>/c exit 0</Arguments></Exec>
  </Actions>
</Task>
