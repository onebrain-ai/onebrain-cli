# One-shot `at:` entry that removes itself after firing.
#
# THREE operations are required, and a single non-shell ExecStopPost= cannot do
# them — which is why this is /bin/sh -c. An earlier version of this file ran
# only `systemctl --user --no-block disable`, WITHOUT --now: that drops the
# symlink but leaves the timer loaded and active, so it fires again. The unit
# looked right and did not work, and the plan's test (asserting the line
# contains "--no-block") passed on it.
#
#   1. disable --now   stop AND unlink; without --now the timer keeps firing
#   2. rm both units   or systemd still knows them after a daemon-reload
#   3. daemon-reload   so the removal is observed
#
# --no-block is mandatory on the systemctl calls: ExecStopPost runs while
# systemd is stopping this unit, so a blocking call waits on the manager's job
# queue while the manager waits for ExecStopPost to exit. That is a deadlock.
#
# NOTE this fires on EVERY stop, including a failed start and a manual
# `systemctl --user start`. A one-shot that never ran successfully still
# deletes itself, with no trace. Accepted; documented here so it is a known
# property rather than a surprise.
[Unit]
Description=OneBrain one-shot skill

[Service]
Type=oneshot
ExecStart=/bin/echo onebrain skill run --vault /home/u/vault --skill /daily --harness claude
ExecStopPost=/bin/sh -c 'systemctl --user --no-block disable --now onebrain-oneshot.timer; rm -f "$HOME/.config/systemd/user/onebrain-oneshot.timer" "$HOME/.config/systemd/user/onebrain-oneshot.service"; systemctl --user --no-block daemon-reload'
