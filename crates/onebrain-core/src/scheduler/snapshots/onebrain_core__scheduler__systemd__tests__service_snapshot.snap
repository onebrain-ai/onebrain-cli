---
source: crates/onebrain-core/src/scheduler/systemd.rs
expression: "generate_service_unit(&daily_entry(), &ctx).unwrap()"
---
[Unit]
Description=OneBrain scheduled entry (daily)

[Service]
Type=oneshot
ExecStart=/usr/local/bin/onebrain skill run --vault /v/ob-1 --skill /daily --harness claude
Environment="ONEBRAIN_VAULT=/v/ob-1"
